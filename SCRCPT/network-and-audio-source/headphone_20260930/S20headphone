#!/bin/sh

start() {
    attempt=0
    while [ "$attempt" -lt 5 ]; do
        if amixer -c Codec info >/dev/null 2>&1; then
            amixer -q -c Codec cset name='Headphone Source Playback Route' 0,0 &&
            amixer -q -c Codec cset name='DAC Playback Volume' 63 &&
            amixer -q -c Codec cset name='Headphone Playback Volume' 40 &&
            amixer -q -c Codec cset name='Headphone Playback Switch' on,on
            return $?
        fi
        attempt=$((attempt + 1))
        sleep 1
    done
    echo 'headphone: Codec sound card unavailable' >&2
    return 1
}

case "${1:-start}" in
    start|restart) start ;;
    stop) amixer -q -c Codec cset name='Headphone Playback Switch' off,off ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac

#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    BIN=/root/f1-ddnsto-ssh/websocat
    [ -x "$BIN" ] || return 1
    [ "$(sha256sum "$BIN" | cut -d ' ' -f1)" = 711a69576a2ff473fb01a90ffafb571c2ed019e55479d7ae71b12c2eadeb7011 ] || return 1
    procd_open_instance
    procd_set_param command "$BIN" --binary --exit-on-eof --buffer-size 65536 --restrict-uri /f1-ssh ws-l:127.0.0.1:18090 tcp:10.0.0.234:22
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
